{"version": 2, "width": 100, "height": 32, "timestamp": 1787923436, "idle_time_limit": 4.0, "env": {}, "title": "scanr — 3. Look before you scan"}
[0.011417, "o", "\r\n\u001b[2;36m# plan resolves a scan without running it: every value with the layer it came\u001b[0m\r\n"]
[0.413189, "o", "\u001b[2;36m# from, both duration bounds, and any warnings. lab-audit is defined in scanr.toml.\u001b[0m\r\n"]
[2.816505, "o", "\u001b[1;32m$\u001b[0m s"]
