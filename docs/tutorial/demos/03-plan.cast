[5.14747, "o", "\u001b[1;36mOverview\u001b[0m\r\nscan            \u001b[1mlab-audit\u001b[0m\r\ndescription     \u001b[2mThe lab hosts through the dante proxy\u001b[0m\r\nprofile         proxy                                   \u001b[2mbuiltin\u001b[0m\r\n\r\n\u001b[1;36mTransport\u001b[0m\r\ntransport       dante (socks5)                          \u001b[2mscan.lab-audit\u001b[0m\r\n  address       127.0.0.1:1082\r\n  fidelity      \u001b[32mfull\u001b[0m                                    \u001b[2mdeclared in config\u001b[0m\r\ndns             auto -> transport (names handed to the proxy to resolve) \u001b[2mbuiltin\u001b[0m\r\n\r\n\u001b[1;36mScope\u001b[0m\r\ntargets         1 (127.0.0.1)\r\nports           5 (25025,28080,28443,29000-29001)\r\nprobes          5\r\nlabels          /etc/services (5,863) + builtin (2)     \u001b[2mbuiltin\u001b[0m\r\norder           randomized, seed 177e68ed95cb4031       \u001b[2mbuiltin\u001b[0m\r\n\r\n\u001b[1;36mTiming\u001b[0m\r\nconcurrency     512                                     \u001b[2mbuiltin.proxy\u001b[0m\r\nrate            400/s                                   \u001b[2mbuiltin.proxy\u001b[0m\r\nconnect_timeout 5s                                      \u001b[2mbuiltin.proxy\u001b[0m\r\nproxy_timeouts  connect 3s, handshake 5s                \u001b[2mbuiltin.proxy\u001b[0m\r\nretries         1 (timeouts only, delay 250ms)          \u001b[2mbuiltin.proxy\u001b[0m\r\n\r\n\u001b[1;36mProbing\u001b[0m\r\nbanner          up to 1024 B, 500ms max wait            \u001b[2mbuiltin\u001b[0m\r\ntls probe       \u001b[2moff\u001b[0m                                     \u001b[2mbuiltin\u001b[0m\r\n\r\n\u001b[1;36mOutput\u001b[0m\r\noutput          ./scanr-results                         \u001b[2mbuiltin\u001b[0m\r\n  format        gzip                                    \u001b[2mbuiltin\u001b[0m\r\n  detail        repeated outcomes collapsed             \u001b[2mbuiltin\u001b[0m\r\n\r\n\u001b[1;36mProjection\u001b[0m\r\nrate-bound      ~0.01s at 400/s if every probe answers\r\ntimeout-bound   \u001b[33m~10.25s if every probe times out (5s x 2 attempts / 512 in flight)\u001b[0m\r\n\r\n\u001b[1;36mHost\u001b[0m\r\nfacts           ephemeral 32768-60999 (28232 ports), tcp_tw_reuse=2 (loopback only), nofile=524288\r\n"]
[7.649297, "o", "\r\n\u001b[2;36m# An ad-hoc plan: a /24 by every port through dante. Look at the duration\u001b[0m\r\n"]
[8.050939, "o", "\u001b[2;36m# estimate before you spend it.\u001b[0m\r\n"]
