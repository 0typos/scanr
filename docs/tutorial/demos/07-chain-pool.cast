[25.821474, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"port\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m25025\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"open\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"via\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"exit-b\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"port\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m28080\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"open\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"via\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"dante\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"port\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m28443\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"open\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"via\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"exit-b\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"port\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m29000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"closed\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"via\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"dante\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"port\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m29001\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"closed\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"via\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"exit-b\"\u001b[0m\u001b[1;39m}\u001b[0m\r\n"]
