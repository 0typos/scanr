[0.011238, "o", "\r\n\u001b[2;36m# A chain: squid, then dante. Its fidelity is the exit hop's, because only the\u001b[0m\r\n"]
[0.412827, "o", "\u001b[2;36m# last CONNECT names the destination — so squid then dante is full.\u001b[0m\r\n"]
