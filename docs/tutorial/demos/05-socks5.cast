[13.97136, "o", "\u001b[1;36mOverview\u001b[0m\r\nscan            \u001b[1mlab-audit\u001b[0m\r\ntransport       dante (socks5 127.0.0.1:1082)  fidelity \u001b[32mfull\u001b[0m\r\nscope           5 probes (1 targets x 5 ports)\r\ntiming          concurrency 512, rate 400/s, connect_timeout 5s\r\nscan id         fbdf33df  \u001b[2mseed c7feb1b1f1d79609\u001b[0m\r\n\r\n\u001b[1;36mResults\u001b[0m\r\n\u001b[2mendpoint             state     service               rtt  banner / tls\u001b[0m\r\n"]
[13.976052, "o", "127.0.0.1:28080/tcp  \u001b[32mopen\u001b[0m                          \u001b[2m1.9ms\u001b[0m\r\n"]
[13.978144, "o", "127.0.0.1:29001/tcp  \u001b[31mclosed\u001b[0m                        \u001b[2m1.7ms\u001b[0m\r\n"]
[13.980974, "o", "127.0.0.1:25025/tcp  \u001b[32mopen\u001b[0m                          \u001b[2m1.9ms\u001b[0m  \u001b[2m220 mail.lab.internal ESMTP ready..\u001b[0m\r\n"]
[13.986037, "o", "127.0.0.1:29000/tcp  \u001b[31mclosed\u001b[0m    saltd-licensing      \u001b[2m2.1ms\u001b[0m\r\n"]
[14.034454, "o", "127.0.0.1:28443/tcp  \u001b[32mopen\u001b[0m                          \u001b[2m1.6ms\u001b[0m\r\n"]
[14.035067, "o", "\r\n\u001b[1;36mSummary\u001b[0m\r\nresult          \u001b[1;32mcompleted\u001b[0m in 0.06s\r\nstates          \u001b[32m3 open\u001b[0m, \u001b[31m2 closed\u001b[0m, \u001b[2m0 filtered\u001b[0m, \u001b[2m0 error\u001b[0m\r\nprobed          5 of 5\r\nrecord          \u001b[1mresults-dante/scan-lab_audit-2026_08_28T05_58_22Z-fbdf33df.jsonl.gz\u001b[0m\r\n"]
[16.536837, "o", "\r\n\u001b[2;36m# The proxy everyone actually uses: ssh -D. OpenSSH sends no SOCKS reply for a\u001b[0m\r\n"]
[16.938363, "o", "\u001b[2;36m# refused port — it just closes the channel. Measure it:\u001b[0m\r\n"]
[19.341324, "o", "\u001b[1;32m$\u001b[0m s"]
[19.382879, "o", "c"]
[19.423907, "o", "a"]
