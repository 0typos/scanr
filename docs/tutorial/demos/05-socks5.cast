[14.050487, "o", "\r\nSummary\r\nresult          completed in 0.06s\r\nstates          3 open, 2 closed, 0 filtered, 0 error\r\nprobed          5 of 5\r\nrecord          results-dante/scan-lab_audit-2026_08_28T13_24_39Z-7ffaae94.jsonl.gz\r\n"]
[16.552817, "o", "\r\n\u001b[2;36m# The proxy everyone actually uses: ssh -D. OpenSSH sends no SOCKS reply for a\u001b[0m\r\n"]
[16.954491, "o", "\u001b[2;36m# refused port — it just closes the channel. Measure it:\u001b[0m\r\n"]
[19.358768, "o", "\u001b[1;32m$\u001b[0m s"]
[19.400721, "o", "c"]
[19.442695, "o", "a"]
[19.484147, "o", "n"]
[19.525648, "o", "r"]
