[14.000556, "o", "127.0.0.1:29000/tcp  closed    saltd-licensing      1.4ms\r\n"]
[14.003477, "o", "127.0.0.1:25025/tcp  open                          1.7ms  220 mail.lab.internal ESMTP ready..\r\n"]
