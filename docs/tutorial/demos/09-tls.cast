[0.011049, "o", "\r\n\u001b[2;36m# Banners are read by default; only services that speak first have one.\u001b[0m\r\n"]
[0.412387, "o", "\u001b[2;36m# --tls sends one fixed ClientHello to silent open ports — the only thing scanr\u001b[0m\r\n"]
[0.813929, "o", "\u001b[2;36m# ever sends — and records what comes back.\u001b[0m\r\n"]
