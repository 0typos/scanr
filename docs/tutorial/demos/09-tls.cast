[10.840766, "o", "\r\n\u001b[2;36m# Three answers: a greeting (never probed), a silent port that closed on the\u001b[0m\r\n"]
[11.242479, "o", "\u001b[2;36m# hello, and a certificate. The leaf is in the record, read but never verified.\u001b[0m\r\n"]
