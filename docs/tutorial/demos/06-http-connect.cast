{"version": 2, "width": 100, "height": 32, "timestamp": 1787896728, "idle_time_limit": 4.0, "env": {}, "title": "scanr — 6. Through an HTTP CONNECT proxy"}
[0.011409, "o", "\r\n\u001b[2;36m# Corporate proxies are HTTP CONNECT. HTTP has no status that means refused:\u001b[0m\r\n"]
[0.412652, "o", "\u001b[2;36m# squid says 503 for both refused and unreachable.\u001b[0m\r\n"]
[2.815834, "o", "\u001b[1;32m$\u001b[0m "]
