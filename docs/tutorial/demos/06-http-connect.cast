[18.046671, "o", "\r\n\u001b[1;36mSummary\u001b[0m\r\nresult          \u001b[1;32mcompleted\u001b[0m in 0.06s\r\nstates          \u001b[32m3 open\u001b[0m, \u001b[2m0 closed\u001b[0m, \u001b[2m0 filtered\u001b[0m, \u001b[35m2 error\u001b[0m\r\nprobed          5 of 5\r\nrecord          \u001b[1mresults-corp/scan-lab_audit-2026_08_28T05_59_06Z-473e334c.jsonl.gz\u001b[0m\r\n"]
