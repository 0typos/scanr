[11.579586, "o", "\u001b[1;36mOverview\u001b[0m\r\nscan            \u001b[1m(ad-hoc)\u001b[0m\r\ntransport       direct\r\nscope           18 probes (3 targets x 6 ports)\r\ntiming          concurrency 2, rate unlimited, connect_timeout 2s\r\nscan id         e1822df6  \u001b[2mseed 0000000000000007\u001b[0m\r\n\r\n\u001b[1;36mResults\u001b[0m\r\n\u001b[2mendpoint             state     service               rtt  banner / tls\u001b[0m\r\n"]
